---
const { frontmatter } = Astro.props;
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{frontmatter.title}</title>

  <style>
    :root {
      font-family:
        "Microsoft YaHei",
        "PingFang SC",
        "Noto Sans SC",
        sans-serif;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at top, rgba(59,130,246,0.08), transparent 35%),
        linear-gradient(135deg, #020617 0%, #0f172a 50%, #111827 100%);
      color: #e2e8f0;
      line-height: 1.9;
    }

    .container {
      width: 100%;
      max-width: 860px;
      margin: 0 auto;
      padding: 72px 28px;
    }

    article {
      background: rgba(15, 23, 42, 0.82);
      border: 1px solid rgba(148,163,184,0.12);
      border-radius: 28px;
      padding: 56px;
      backdrop-filter: blur(18px);
      box-shadow:
        0 20px 60px rgba(0,0,0,0.45);
    }

    h1 {
      font-size: 3rem;
      line-height: 1.2;
      color: #dbeafe;
      margin-bottom: 12px;
    }

    .date {
      color: #94a3b8;
      margin-bottom: 48px;
    }

    p {
      font-size: 1.12rem;
      color: #e2e8f0;
    }

    h2, h3 {
      margin-top: 48px;
      color: #bfdbfe;
    }

    a {
      color: #93c5fd;
    }

    blockquote {
      border-left: 4px solid #3b82f6;
      margin: 24px 0;
      padding: 8px 20px;
      background: rgba(30,41,59,0.45);
      border-radius: 12px;
      color: #cbd5e1;
    }

    code {
      background: rgba(30,41,59,0.9);
      padding: 2px 6px;
      border-radius: 6px;
      font-size: 0.95rem;
    }

    pre {
      overflow-x: auto;
      padding: 20px;
      border-radius: 18px;
      background: #020617;
    }

    img {
      max-width: 100%;
      border-radius: 18px;
    }

    .back {
      display: inline-block;
      margin-bottom: 36px;
      color: #93c5fd;
      text-decoration: none;
    }

    .comments {
      margin-top: 64px;
    }

    @media (max-width: 768px) {
      article {
        padding: 28px;
      }

      h1 {
        font-size: 2.1rem;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <a class="back" href="/">← 返回首页</a>

    <article>
      <h1>{frontmatter.title}</h1>

      <div class="date">
        {frontmatter.date}
      </div>

      <slot />

      <div class="comments">

       <script src="https://giscus.app/client.js"
        data-repo="[在此输入仓库]"
        data-repo-id="[在此输入仓库 ID]"
        data-category="[在此输入分类名]"
        data-category-id="[在此输入分类 ID]"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="dark_dimmed"
        data-lang="zh-CN"
        crossorigin="anonymous"
        async>
</script>

      </div>
    </article>
  </div>
</body>
</html>
