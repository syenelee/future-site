---
const { frontmatter } = Astro.props;
---

<html lang="zh-CN">
<head>
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta name="theme-color" content="#0b1220" />  
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<title>{frontmatter.title}</title>

<style>
  :root {
    font-family:
      "Microsoft YaHei",
      "PingFang SC",
      "Noto Sans SC",
      sans-serif;
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at top, rgba(59,130,246,0.08), transparent 35%),
      linear-gradient(135deg, #020617 0%, #0f172a 50%, #111827 100%);
    color: #e2e8f0;
    line-height: 1.9;
  }

  /* 顶部导航栏 */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    z-index: 1000;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 0 32px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  }

  .brand {
    font-size: 1.2rem;
    font-weight: 700;
    color: #93c5fd;
  }

  .navbar nav a {
    margin-left: 20px;
    text-decoration: none;
    color: #e2e8f0;
  }

  .container {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 100px 28px 72px;
  }

  article {
    background: rgba(15, 23, 42, 0.82);
    border: 1px solid rgba(148,163,184,0.12);
    border-radius: 28px;
    padding: 56px;
    backdrop-filter: blur(18px);
    box-shadow:
      0 20px 60px rgba(0,0,0,0.45);
  }

  h1 {
    font-size: 3rem;
    line-height: 1.2;
    color: #dbeafe;
    margin-bottom: 12px;
  }

  .date {
    color: #94a3b8;
    margin-bottom: 48px;
  }

  p {
    font-size: 1.12rem;
    color: #e2e8f0;
  }

  h2, h3 {
    margin-top: 48px;
    color: #bfdbfe;
  }

  a {
    color: #93c5fd;
  }

  blockquote {
    border-left: 4px solid #3b82f6;
    margin: 24px 0;
    padding: 8px 20px;
    background: rgba(30,41,59,0.45);
    border-radius: 12px;
    color: #cbd5e1;
  }

  code {
    background: rgba(30,41,59,0.9);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.95rem;
  }

  pre {
    overflow-x: auto;
    padding: 20px;
    border-radius: 18px;
    background: #020617;
  }

  img {
    max-width: 100%;
    border-radius: 18px;
  }

  .comments {
    margin-top: 64px;
  }

  /* Cusdis 评论区 */
  #cusdis_thread {
    width: 100%;
    overflow: visible !important;
  }

  #cusdis_thread iframe {
    width: 100% !important;
    border: none !important;
    display: block !important;
  }

  #cusdis_thread input,
  #cusdis_thread textarea {
    background: #1a1a1a !important;
    color: #ffffff !important;
    border: 1px solid #334155 !important;
  }

  #cusdis_thread input::placeholder,
  #cusdis_thread textarea::placeholder {
    color: #94a3b8 !important;
    opacity: 1 !important;
  }

  #cusdis_thread label,
  #cusdis_thread span,
  #cusdis_thread p,
  #cusdis_thread * {
    color: #e2e8f0 !important;
  }

  #cusdis_thread button {
    background: #2563eb !important;
    color: white !important;
    border: none !important;
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 0 16px;
    }

    .navbar nav a {
      margin-left: 12px;
      font-size: 0.9rem;
    }

    article {
      padding: 28px;
    }

    h1 {
      font-size: 2.1rem;
    }
  }
</style>
</head>

<body>

  <header class="navbar">
    <div class="brand">Future5</div>
    <nav>
      <a href="/">首页</a>
      <a href="/#blog">博客</a>
      <a href="/#about">关于</a>
      <a href="/archive">归档</a>
    </nav>
  </header>

  <div class="container">
    <article>
      <h1>{frontmatter.title}</h1>

      <div class="date">
        {frontmatter.date}
      </div>

      <slot />

      <div id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id="144a18db-d90a-49b3-be55-10810219260c"
        data-page-id={Astro.url.pathname}
        data-page-url={Astro.url}
        data-page-title={frontmatter.title}
        data-lang="zh-cn"
        data-theme="dark"
        data-page-size="20"
      ></div>

      <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>

    </article>
  </div>
</body>
</html>
