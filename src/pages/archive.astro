---
const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).sort((a, b) => {
  return new Date(b.frontmatter.date) - new Date(a.frontmatter.date);
});
---

<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />

  <title>文章归档</title>

  <!-- favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <meta name="theme-color" content="#0b1220" />

  <style>
    body {
      margin: 0;
      font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
      background:
        radial-gradient(circle at top, rgba(59,130,246,0.1), transparent 40%),
        linear-gradient(135deg, #020617 0%, #0f172a 50%, #111827 100%);
      color: #e2e8f0;
      min-height: 100vh;
    }

    /* 顶部导航栏 */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 64px;
      z-index: 1000;

      display: flex;
      justify-content: space-between;
      align-items: center;

      padding: 0 32px;
      background: rgba(15, 23, 42, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(148, 163, 184, 0.12);
    }

    .brand {
      font-size: 1.2rem;
      font-weight: 700;
      color: #93c5fd;
    }

    .navbar nav a {
      margin-left: 20px;
      text-decoration: none;
      color: #e2e8f0;
    }

    .container {
      max-width: 760px;
      margin: 0 auto;
      padding: 100px 24px 60px;
    }

    h1 {
      margin-bottom: 40px;
      color: #93c5fd;
      font-size: 2.6rem;
    }

    .item {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 18px 0;
      border-bottom: 1px solid rgba(148,163,184,0.12);
      text-decoration: none;
      color: #e2e8f0;
      transition: 0.2s ease;
    }

    .item:hover {
      color: #93c5fd;
      transform: translateX(4px);
    }

    .date {
      color: #94a3b8;
      flex-shrink: 0;
    }

    @media (max-width: 768px) {
      .navbar {
        padding: 0 16px;
      }

      .navbar nav a {
        margin-left: 12px;
        font-size: 0.9rem;
      }

      h1 {
        font-size: 2rem;
      }

      .item {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>
</head>

<body>

  <header class="navbar">
    <div class="brand">Future5</div>
    <nav>
      <a href="/">首页</a>
      <a href="/#blog">博客</a>
      <a href="/#about">关于</a>
      <a href="/archive">归档</a>
    </nav>
  </header>

  <div class="container">
    <h1>文章归档</h1>

    {posts.map((post) => (
      <a href={post.url} class="item">
        <span>{post.frontmatter.title}</span>
        <span class="date">{post.frontmatter.date}</span>
      </a>
    ))}
  </div>

</body>
</html>
