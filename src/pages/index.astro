
---
const title = "Future5";

const posts = Object.values(
  import.meta.glob("./posts/*.md", { eager: true })
).sort((a, b) => {
  return new Date(b.frontmatter.date) - new Date(a.frontmatter.date);
});
---

<html lang="zh-CN">
  <head>
    <meta name="description" content="关于科技、历史、AI 与未来的个人博客。" />
    <meta name="keywords" content="AI, 历史, 科技, 哲学, 博客, 未来" />
    <meta name="author" content="未来" />

    <meta property="og:title" content="Future5" />
    <meta property="og:description" content="关于科技、思考与未来的个人空间。" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://future-site-five.vercel.app/" />

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0b1220" />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
        color: #e5e7eb;
        background:
  radial-gradient(circle at top, rgba(59,130,246,0.12), transparent 40%),
  linear-gradient(135deg, #020617 0%, #0f172a 45%, #111827 100%);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        scroll-behavior: smooth;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 32px;
        background: rgba(15, 23, 42, 0.72);
        backdrop-filter: blur(10px);
      }

      .navbar nav a {
        margin-left: 20px;
        text-decoration: none;
        color: #e2e8f0;
      }

      .brand {
        font-size: 1.2rem;
        font-weight: 700;
        color: #93c5fd;
      }

      .page {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 32px;
        padding: 24px;
      }

      .card {
  width: 100%;
  max-width: 820px;
  background: rgba(15, 23, 42, 0.78);
  border-radius: 28px;
  padding: 52px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255,255,255,0.03);
  backdrop-filter: blur(18px);
}

      h1 {
        scroll-margin-top: 100px;
        font-size: 3rem;
        margin-bottom: 16px;
        color: #93c5fd;
        text-shadow: 0 0 24px rgba(96,165,250,0.22);
      }

      h2 {
        font-size: 2rem;
        margin-bottom: 20px;
        color: #bfdbfe;
      }

      .post-list {
        display: grid;
        gap: 20px;
      }

      .post-item {
  display: block;
  text-decoration: none;
  padding: 24px;
  border-radius: 20px;
  background: rgba(30, 41, 59, 0.72);
  border: 1px solid rgba(148, 163, 184, 0.15);
  transition: all 0.25s ease;
}

.post-item:hover {
  transform: translateY(-4px);
  background: rgba(51, 65, 85, 0.92);
  border-color: rgba(96, 165, 250, 0.45);
  box-shadow: 0 12px 30px rgba(37, 99, 235, 0.18);
}

.post-meta {
  font-size: 0.9rem;
  color: #94a3b8;
  margin-bottom: 12px;
  letter-spacing: 0.04em;
}
      .post-item h3 {
        margin-bottom: 10px;
        color: #dbeafe;
      }

      p {
        font-size: 1.2rem;
        line-height: 1.8;
        color: #e2e8f0;
        margin-bottom: 20px;
      }

      .btn {
        display: inline-block;
        margin-top: 12px;
        padding: 14px 28px;
        border-radius: 999px;
        background: linear-gradient(135deg, #3b82f6, #6366f1);
        color: white;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow:
    0 10px 30px rgba(59,130,246,0.45),
    0 0 18px rgba(96,165,250,0.35);
}

      @media (max-width: 768px) {
        .card {
          padding: 28px;
        }

        h1 {
          font-size: 2.2rem;
        }
      }
    </style>
  </head>

  <body>
    
<header class="navbar">
      <div class="brand">Future5</div>
      <nav>
        <a href="#home">首页</a>
        <a href="#blog">博客</a>
        <a href="#about">关于</a>
        <a href="/archive">归档</a>
      </nav>
    </header>

    <main class="page">
      <section class="card hero" id="home">
        <h1>你好，欢迎来到Future5</h1>
        <p>
          “Future5”是一个关于科技、思考与创造的个人空间。这里会记录我与AI对话的观察、灵感以及对世界变化的想法。部分内容由AI整理。
        </p>
      
        <a href="#blog" class="btn">阅读博客</a>
      </section>

<section class="card posts" id="blog">
  <h2>最新文章</h2>

  <div class="post-list">
    {posts.map((post) => (
      <a href={post.url} class="post-item">
        <div class="post-meta">
          {post.frontmatter.date}
        </div>

        <h3>
          {post.frontmatter.title}
        </h3>

        <p>
          {post.frontmatter.description || "点击阅读完整内容"}
        </p>
      </a>
    ))}
  </div>
</section>
    </main>
  </body>
</html>
